FROM node:24.19.0-bookworm-slim
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN npm install --global --ignore-scripts --no-audit --no-fund pnpm@11.25.0 \
    && pnpm install --frozen-lockfile --prod --ignore-scripts
COPY server ./server
COPY tincture-site ./tincture-site
ENV NODE_ENV=production
ENV PORT=10000
EXPOSE 10000
USER node
CMD ["node", "server/index.mjs"]
