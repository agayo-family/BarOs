# Dev defaults to SQLite. Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=sqlite:///./data/baros.db
SESSION_SECRET=change-me-in-production
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15
COOKIE_SECURE=0
FIRST_RUN_TOKEN=change-this-before-start

# Free AI by default. Paid fallback is opt-in only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
AI_ALLOW_PAID_FALLBACK=0
AI_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=20
AI_PROVIDER_DAILY_CALL_LIMIT=20

# Optional paid fallback, disabled unless AI_ALLOW_PAID_FALLBACK=1.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_MODEL=openai/gpt-5.6-sol

# Direct OpenAI: requires all three opt-in settings and an eligible API account.
# API billing is separate from ChatGPT. See docs/OPENAI_SETUP.md before payment.
AI_PROVIDER=auto
OPENAI_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_DAILY_BUDGET_USD=1
OPENAI_MONTHLY_BUDGET_USD=10
OPENAI_JOB_BUDGET_USD=0.75
# When enabling OpenAI, set AI_PROVIDER_DAILY_CALL_LIMIT=200 (the free default above is 20).

# Qwen + personal pet mentor: opt-in only. See docs/QWEN_MENTOR_SETUP.md.
# To activate, set AI_PROVIDER=qwen, MENTOR_PROVIDER=qwen, QWEN_ENABLED=1.
# Singapore International workspace endpoint, copied from Alibaba Model Studio:
MENTOR_PROVIDER=auto
QWEN_ENABLED=0
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_CHAT_MODEL=qwen3.5-flash
QWEN_AUTHOR_MODEL=qwen3.5-plus
AI_DAILY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=10
AI_VENUE_DAILY_BUDGET_USD=1
AI_VENUE_MONTHLY_BUDGET_USD=5
AI_EMPLOYEE_DAILY_BUDGET_USD=0.05
AI_JOB_BUDGET_USD=0.75
MENTOR_EMPLOYEE_DAILY_MESSAGES=30
MENTOR_VENUE_DAILY_MESSAGES=300
MENTOR_EMPLOYEE_DAILY_CALLS=60
MENTOR_VENUE_DAILY_CALLS=600

# Optional Yandex reserve, disabled unless explicitly configured and enabled.
# Built-in prices are for a RUB billing account, including VAT.
AI_YANDEX_FALLBACK=0
YANDEX_ENABLED=0
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_CHAT_MODEL=aliceai-llm-flash
YANDEX_AUTHOR_MODEL=qwen3.6-35b-a3b
AI_DAILY_BUDGET_RUB=100
AI_MONTHLY_BUDGET_RUB=1000
AI_VENUE_DAILY_BUDGET_RUB=100
AI_VENUE_MONTHLY_BUDGET_RUB=500
AI_EMPLOYEE_DAILY_BUDGET_RUB=10
AI_JOB_BUDGET_RUB=100

# Web Push (optional; a VAPID key is generated and stored automatically).
VAPID_SUBJECT=https://baros.example
