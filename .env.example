# Dev defaults to SQLite. Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=sqlite:///./data/baros.db
SESSION_SECRET=change-me-in-production
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15
COOKIE_SECURE=0
FIRST_RUN_TOKEN=change-this-before-start

# Free AI by default. Paid fallback is opt-in only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
AI_ALLOW_PAID_FALLBACK=0
AI_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=20
AI_PROVIDER_DAILY_CALL_LIMIT=20

# Optional paid fallback, disabled unless AI_ALLOW_PAID_FALLBACK=1.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_MODEL=openai/gpt-5.6-sol

# Direct OpenAI: requires all three opt-in settings and an eligible API account.
# API billing is separate from ChatGPT. See docs/OPENAI_SETUP.md before payment.
AI_PROVIDER=auto
OPENAI_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_DAILY_BUDGET_USD=1
OPENAI_MONTHLY_BUDGET_USD=10
OPENAI_JOB_BUDGET_USD=0.75
# When enabling OpenAI, set AI_PROVIDER_DAILY_CALL_LIMIT=200 (the free default above is 20).

# Web Push (optional; a VAPID key is generated and stored automatically).
VAPID_SUBJECT=https://baros.example
